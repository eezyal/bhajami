  "sanitizer": {
    "leadingNumberRegex": "^\\s*\\d{1,5}\\s*[-–—:.|)]\\s*",
    "pipeSuffixRegexes": [
      "\\|\\s*(?:sri\\s+|shri\\s+)?sathya\\s+sai\\s+b[bh]?ajans.*$",
      "\\|\\s*prasanthi\\s+mandir\\s+live.*$",
      "\\|\\s*sss\\s*mc.*$",
      "\\|\\s*radio\\s+sai.*$",
      "\\|\\s*(?:with\\s+)?bhajan\\s+lyrics.*$",
      "\\|\\s*with\\s+lyrics.*$"
    ],
    "hashtagRegex": "#[a-zA-Z0-9_]+",
    "bracketedTagRegex": "[\\(\\[\\{]\\s*(?:unplugged|baba\\s+sings|swami\\s+sings|centenary\\s+birthday\\s+special\\s+offering|centenary\\s+special|special\\s+offering|with\\s+lyrics|lyrics|live|audio|video|official|full\\s+song|hd|4k|male|female|gents|ladies|karaoke|instrumental)\\s*[\\)\\]\\}]",
    "trailingTagRegex": "(?:\\s*[-–—|]\\s*|\\s+)(?:centenary\\s+birthday\\s+special\\s+offering|centenary\\s+special\\s+offering|baba\\s+sings|swami\\s+sings|unplugged|with\\s+lyrics)\\s*$"
  },
  "repetitionRegex": "\\(\\s*\\d+\\s*(?:times?|x)?\\s*\\)",
  "punctuationRegex": "[\\x21-\\x2f\\x3a-\\x40\\x5b-\\x60\\x7b-\\x7e\\u2000-\\u206f\\u00a0-\\u00bf]+",
  "vowelAndConsonantRules": [
    ["aa+", "a"],
    ["(?:ee+|ii+)", "i"],
    ["(?:oo+|uu+)", "u"],
    ["w", "v"],
    ["x", "ksh"]
  ],
  "tokenAliases": {
    "aum": "om"
  },
  "collapseDoubledConsonantsRegex": "([bcdfghjklmnpqrstvwxz])\\1+",
  "nasalStemExceptions": [
    "narayan",
    "bhagavan",
    "gopal",
    "keshav",
    "madhav",
    "raghav",
    "govind",
    "krishn",
    "ram",
    "shyam",
    "ganesh",
    "jagadish",
    "mahesh",
    "mukund",
    "anand"
  ],
  "substitutionCosts": {
    "interiorVowelPairs": [
      ["e", "a", 0.3]
    ],
    "singleCharPairs": [
      ["v", "b", 0.35]
    ],
    "digraphPairs": [
      ["sh", "s", 0.25],
      ["ksh", "sh", 0.25],
      ["bh", "b", 0.2],
      ["dh", "d", 0.2],
      ["th", "t", 0.2],
      ["kh", "k", 0.2],
      ["gh", "g", 0.2],
      ["ph", "p", 0.2]
    ],
    "defaultEdit": 1.0
  },
