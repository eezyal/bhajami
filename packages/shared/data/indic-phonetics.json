  "thresholds": {
    "autoMerge": 0.9,
    "reviewMin": 0.72,
    "lyricsOverlapMin": 0.55,
    "glossaryVarMin": 0.78
  },
  "schwaFoldPenalty": 0.05,
  "diacriticMap": {
    "ā": "a",
