# Firebase Client SDK (project: saibhajanverse)
# Populate via Firebase Console -> Project Settings -> Your Apps (Web)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=saibhajanverse.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=saibhajanverse
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=saibhajanverse.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Admin & Lyrics Moderation Target
ADMIN_EMAIL=pschax@gmail.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Cloud Firestore sync now works automatically via NEXT_PUBLIC_FIREBASE_* + Google Sign-In (pschax@gmail.com) without a service account key file.
# Set GOOGLE_APPLICATION_CREDENTIALS only if you also want server-side Admin SDK access without browser sign-in.
# GOOGLE_APPLICATION_CREDENTIALS=/Users/chax/.config/bhajami/saibhajanverse-admin.json

# Live Email Option B (Direct Gmail SMTP — paste a 16-char Google App Password for pschax@gmail.com)
GMAIL_USER=pschax@gmail.com
GMAIL_APP_PASSWORD=

# Live Email Option A (Resend API — free 3,000 emails/mo at https://resend.com)
RESEND_API_KEY=
RESEND_FROM=bhaJami Moderation <onboarding@resend.dev>
